{
  "name": "senox",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1"
  },
  "scripts": {
    "dev": "bun run --filter @senox/blog dev",
    "dev:blog": "bun run --filter @senox/blog dev",
    "build": "bun run --filter @senox/blog build",
    "build:blog": "bun run --filter @senox/blog build",
    "typecheck": "bun run --filter @senox/blog typecheck",
    "preview:blog": "bun run --filter @senox/blog preview",
    "cf-dev:blog": "bun run --filter @senox/blog cf-dev",
    "astro:blog": "bun run --filter @senox/blog astro",
    "tags": "bun run --filter @senox/blog tags",
    "tags:check": "bun run --filter @senox/blog tags:check",
    "prepare:git": "bun run --filter @senox/blog prepare:git"
  }
}
