{
  "name": "@senox/blog",
  "private": true,
  "type": "module",
  "version": "0.0.30",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && bun src/dev_tools/prepare_deploy.ts",
    "typecheck": "tsc --noEmit",
    "preview": "astro preview",
    "cf-dev": "wrangler pages dev ../../dist",
    "astro": "astro",
    "open-article": "bun src/dev_tools/open_article.ts",
    "tags": "bun src/dev_tools/check_tags.ts",
    "tags:check": "bun src/dev_tools/check_tags.ts --check",
    "prepare:git": "bun src/dev_tools/prepare_push.ts",
    "prepare:push": "bun run prepare:git"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.4",
    "astro": "^7.2.6",
    "prompts": "^2.4.2",
    "rehype-external-links": "^3.0.0",
    "satori": "^0.16.2",
    "satori-html": "^0.3.2",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^25.9.5",
    "@types/prompts": "^2.4.9",
    "remark-directive": "^4.0.0",
    "sharp": "^0.34.5",
    "typescript": "^7.0.2"
  }
}
