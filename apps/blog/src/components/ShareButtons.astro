---
// src/components/ShareButtons.astro
const { title, url, wordCount } = Astro.props as {
  title: string;
  url: string;
  wordCount?: number;
};
const encoded = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);
const shareLinks = [
  {
    name: "X",
    href: `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encoded}&via=senox78`,
  },
  {
    name: "Hatena",
    href: `https://b.hatena.ne.jp/entry/s/${url.replace(/^https?:\/\//, "")}`,
  },
  {
    name: "マシュマロで匿名の感想を",
    href: "https://marshmallow-qa.com/db8xew1t5oa5l19",
  },
];
---

<div class="share-buttons" data-pagefind-ignore>
  <div>
    <div class="share-links">
      <span>Share:</span>
      {
        shareLinks.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class="external-link"
          >
            {link.name}
          </a>
        ))
      }
    </div>
    <div class="share-native">
      <button id="share-btn" class="external-link">Share with</button>
    </div>
  </div>
  {
    typeof wordCount === "number" && (
      <div class="share-meta">
        <span class="word-count">
          {wordCount.toLocaleString("ja-JP")} words
        </span>
      </div>
    )
  }
</div>

<style>
  .share-buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.25rem 0.8rem;
    font-size: 1rem;
    line-height: 1.5;
    margin-top: 2rem;
    a {
      font-size: 1rem;
    }
  }

  .share-buttons > div {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.2rem 0.6rem;
  }

  .share-links {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  /* 日本語フォントと欧文フォントで行ボックスの高さが異なっても、
     各リンクを同じ高さの中央に揃える。 */
  .share-links > .external-link,
  #share-btn {
    display: inline-flex;
    align-items: center;
    min-height: 1.5em;
    line-height: 1.5;
  }

  .share-meta {
    color: var(--heading-prefix);
    white-space: nowrap;
  }

  /* 下線まわりはpost.cssの`.prose a`と同じレシピ(buttonなのでクラス共有できず複製) */
  #share-btn {
    display: none;
    white-space: nowrap;
    background: none;
    border: none;
    padding: 0;
    margin-left: 0.2rem;
    margin-right: 0.1rem;
    font: inherit;
    cursor: pointer;
    color: var(--a-link-in-post);
    text-decoration: none;
    background-image: linear-gradient(
      var(--a-under-in-post-hovered),
      var(--a-under-in-post-hovered)
    );
    background-repeat: no-repeat;
    background-position: left bottom;
    background-size: 0 1px;
    transition: background-size 0.3s ease-in-out;
    padding-bottom: 0;
  }

  #share-btn:hover {
    color: var(--a-link-in-post-hovered);
    background-size: 100% 1px;
  }

  @media (max-width: 640px) {
    #share-btn {
      display: inline-flex;
    }
  }
</style>

<script>
  const btn = document.getElementById("share-btn");

  const legacyCopy = (text: string) => {
    const ta = document.createElement("textarea");
    ta.value = text;
    ta.setAttribute("readonly", "");
    ta.style.position = "fixed";
    ta.style.opacity = "0";
    document.body.appendChild(ta);
    ta.select();
    let ok = false;
    try {
      ok = document.execCommand("copy");
    } catch {
      ok = false;
    }
    document.body.removeChild(ta);
    return ok;
  };

  const copyUrl = async (url: string) => {
    // navigator.clipboard is only available in secure contexts (HTTPS/localhost)
    if (navigator.clipboard && window.isSecureContext) {
      try {
        await navigator.clipboard.writeText(url);
        return true;
      } catch {
        // fall through to legacy path
      }
    }
    return legacyCopy(url);
  };

  btn?.addEventListener("click", async () => {
    const url = location.href;
    if (navigator.share) {
      try {
        await navigator.share({ title: document.title, url });
      } catch (err) {
        // AbortError = user cancelled the share sheet; ignore it
        if ((err as Error)?.name !== "AbortError") {
          if (await copyUrl(url)) alert("URLをコピーしました！");
        }
      }
      return;
    }
    if (await copyUrl(url)) {
      alert("URLをコピーしました！");
    } else {
      alert("コピーできませんでした。URL: " + url);
    }
  });
</script>
