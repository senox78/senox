---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  title="Search - Compute on Snails"
  description="Search article text and URLs"
>
  <h2>Search</h2>
  <form id="grep-form" role="search">
    <label class="sr-only" for="grep-query">
      Search article text and URLs with a regular expression
    </label>
    <div class="grep-input-row">
      <input
        id="grep-query"
        type="search"
        inputmode="search"
        autocomplete="off"
        spellcheck="false"
        autofocus
        placeholder="Search article text and URLs with regex…"
      />
      <button type="submit">Search</button>
    </div>
    <label class="grep-option">
      <input id="grep-case-sensitive" type="checkbox" /> Case-sensitive
    </label>
  </form>
  <p id="grep-status" role="status" aria-live="polite"></p>
  <div id="grep-results"></div>
</MainLayout>

<script>
  import { blogPath } from "../utils/paths";

  const grepForm = document.getElementById("grep-form");
  const grepInput = document.getElementById("grep-query") as HTMLInputElement;
  const caseSensitive = document.getElementById(
    "grep-case-sensitive",
  ) as HTMLInputElement;
  const grepStatus = document.getElementById("grep-status");
  const grepResults = document.getElementById("grep-results");
  const params = new URLSearchParams(location.search);

  type GrepLine = { text: string; anchor?: string };
  type GrepArticle = { title: string; url: string; lines: GrepLine[] };
  let indexPromise: Promise<GrepArticle[]> | undefined;

  function updateUrl(query: string) {
    const url = new URL(location.href);
    if (query) url.searchParams.set("q", query);
    else url.searchParams.delete("q");
    url.searchParams.delete("mode");
    if (caseSensitive.checked) url.searchParams.set("case", "1");
    else url.searchParams.delete("case");
    history.replaceState(null, "", url);
  }

  function loadIndex() {
    indexPromise ??= fetch(blogPath("/grep-index.json"))
      .then((response) => {
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        return response.json();
      })
      .then((data: { articles: GrepArticle[] }) => data.articles);
    return indexPromise;
  }

  function appendHighlighted(
    target: HTMLElement,
    text: string,
    expression: RegExp,
  ) {
    let cursor = 0;
    for (const match of text.matchAll(expression)) {
      const start = match.index;
      const value = match[0];
      target.append(text.slice(cursor, start));
      const mark = document.createElement("mark");
      mark.textContent = value;
      target.append(mark);
      cursor = start + value.length;
      if (!value) break;
    }
    target.append(text.slice(cursor));
  }

  async function runGrep() {
    const query = grepInput.value.trim();
    updateUrl(query);
    grepResults?.replaceChildren();
    if (!query) {
      if (grepStatus) grepStatus.textContent = "Enter a regular expression.";
      return;
    }

    let expression: RegExp;
    try {
      expression = new RegExp(query, caseSensitive.checked ? "gu" : "giu");
    } catch (error) {
      if (grepStatus) {
        grepStatus.textContent = `Invalid regular expression: ${(error as Error).message}`;
      }
      return;
    }

    if (grepStatus) grepStatus.textContent = "Searching…";
    try {
      const articles = await loadIndex();
      let lineMatchCount = 0;
      let urlMatchCount = 0;
      let articleCount = 0;

      for (const article of articles) {
        const fullUrl = new URL(article.url, location.origin).href;
        expression.lastIndex = 0;
        const urlMatches = expression.test(`${article.url}\n${fullUrl}`);
        if (urlMatches) urlMatchCount += 1;

        const matched = article.lines.flatMap((line, index) => {
          expression.lastIndex = 0;
          const matches = expression.test(line.text);
          if (matches) lineMatchCount += 1;
          return matches ? [index] : [];
        });
        if (!urlMatches && !matched.length) continue;
        articleCount += 1;

        const section = document.createElement("section");
        section.className = "grep-result";
        const heading = document.createElement("h3");
        const articleLink = document.createElement("a");
        articleLink.href = article.url;
        articleLink.target = "_blank";
        articleLink.rel = "noopener noreferrer";
        articleLink.textContent = article.title;
        heading.append(articleLink);
        section.append(heading);

        if (urlMatches) {
          const urlLink = document.createElement("a");
          urlLink.className = "grep-url";
          urlLink.href = article.url;
          urlLink.target = "_blank";
          urlLink.rel = "noopener noreferrer";
          expression.lastIndex = 0;
          appendHighlighted(urlLink, fullUrl, expression);
          section.append(urlLink);
        }

        const ranges: Array<[number, number]> = [];
        for (const index of matched) {
          const start = Math.max(0, index - 2);
          const end = Math.min(article.lines.length - 1, index + 2);
          const previous = ranges.at(-1);
          if (previous && start <= previous[1] + 1) previous[1] = end;
          else ranges.push([start, end]);
        }

        for (const [start, end] of ranges) {
          const block = document.createElement("pre");
          block.className = "grep-context";
          for (let index = start; index <= end; index += 1) {
            const line = article.lines[index];
            const row = document.createElement("a");
            row.className = matched.includes(index)
              ? "grep-line is-match"
              : "grep-line";
            row.href = `${article.url}${line.anchor ? `#${line.anchor}` : ""}`;
            row.target = "_blank";
            row.rel = "noopener noreferrer";
            const number = document.createElement("span");
            number.className = "grep-line-number";
            number.textContent = String(index + 1);
            const content = document.createElement("span");
            content.className = "grep-line-text";
            expression.lastIndex = 0;
            appendHighlighted(content, line.text, expression);
            row.append(number, content);
            block.append(row);
          }
          section.append(block);
        }
        grepResults?.append(section);
      }

      if (grepStatus) {
        grepStatus.textContent = `${articleCount} articles, ${lineMatchCount} text lines, ${urlMatchCount} URLs matched`;
      }
    } catch {
      if (grepStatus) {
        grepStatus.textContent = "Could not load the search index.";
      }
    }
  }

  grepForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    void runGrep();
  });
  caseSensitive.addEventListener("change", () => void runGrep());
  let grepTimer: ReturnType<typeof setTimeout>;
  grepInput.addEventListener("input", () => {
    clearTimeout(grepTimer);
    grepTimer = setTimeout(() => void runGrep(), 300);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "/" || event.metaKey || event.ctrlKey || event.altKey) {
      return;
    }
    const target = event.target;
    if (
      target instanceof HTMLInputElement ||
      target instanceof HTMLTextAreaElement ||
      (target instanceof HTMLElement && target.isContentEditable)
    ) {
      return;
    }
    event.preventDefault();
    grepInput.focus();
  });

  grepInput.value = params.get("q")?.trim() ?? "";
  caseSensitive.checked = params.get("case") === "1";
  if (grepInput.value) void runGrep();
</script>

<style>
  .grep-input-row {
    display: flex;
    gap: 0.5rem;
  }

  #grep-query {
    min-width: 0;
    flex: 1;
    border: 1px solid var(--line-color);
    border-radius: 6px;
    padding: 0.7rem 0.8rem;
    background: var(--background);
    color: var(--text);
    font: 500 1rem var(--base-fonts-mono);
  }

  .grep-input-row button {
    border: 1px solid var(--line-color);
    border-radius: 6px;
    padding: 0.5rem 1rem;
    background: var(--table-stripe-bg);
    color: var(--text);
    font: inherit;
    cursor: pointer;
  }

  #grep-form input:focus-visible,
  #grep-form button:focus-visible,
  .grep-line:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .grep-option {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.7rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  #grep-status {
    min-height: 1.5em;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
</style>

<style is:global>
  #grep-results .grep-result {
    margin: 1.5rem 0;
  }

  #grep-results .grep-result h3 {
    margin-bottom: 0.5rem;
    font-size: 1.1rem;
  }

  #grep-results .grep-url {
    display: block;
    overflow-wrap: anywhere;
    margin: -0.2rem 0 0.75rem;
    color: var(--text-muted);
    font-family: var(--base-fonts-mono);
    font-size: 0.82rem;
  }

  #grep-results .grep-context {
    overflow-x: auto;
    margin: 0 0 0.75rem;
    border: 1px solid var(--line-color);
    border-radius: 6px;
    padding: 0.4rem 0;
    background: var(--table-bg);
    font-family: var(--base-fonts-mono);
    font-size: 0.85rem;
    line-height: 1.55;
  }

  #grep-results .grep-line {
    display: grid;
    grid-template-columns: 4ch minmax(max-content, 1fr);
    color: var(--text-muted);
    text-decoration: none;
  }

  #grep-results .grep-line:hover,
  #grep-results .grep-line:focus-visible {
    background: var(--table-hover-bg);
  }

  #grep-results .grep-line.is-match {
    color: var(--text);
    background: var(--table-stripe-bg);
  }

  #grep-results .grep-line-number {
    padding: 0 0.65rem;
    border-right: 1px solid var(--line-color);
    color: var(--text-muted);
    text-align: right;
    user-select: none;
  }

  #grep-results .grep-line-text {
    padding: 0 0.7rem;
    white-space: pre;
  }

  #grep-results mark {
    background: none;
    color: inherit;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 2px;
  }
</style>
